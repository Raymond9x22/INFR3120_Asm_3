<%- include('../partials/header') %>

<h1><i class="fa-solid fa-list"></i> My Workouts</h1>

<!-- message after add / update / delete -->
<% if (message) { %>
  <div class="alert alert-success"><%= message %></div>
<% } %>

<a href="/workouts/add" class="btn btn-outline-navy mb-3"><i class="fa-solid fa-plus"></i> Add Workout</a>

<% if (workouts.length == 0) { %>
  <p>No workouts yet. Click "Add Workout" to make your first one.</p>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="fit-thead">
        <tr>
          <th>Date</th>
          <th>Exercise</th>
          <th>Category</th>
          <th>Sets</th>
          <th>Reps</th>
          <th>Minutes</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (var i = 0; i < workouts.length; i++) { %>
          <tr>
            <td><%= workouts[i].date.toISOString().substring(0, 10) %></td>
            <td><%= workouts[i].exercise %></td>
            <td><%= workouts[i].category %></td>
            <td><%= workouts[i].sets %></td>
            <td><%= workouts[i].reps %></td>
            <td><%= workouts[i].duration %></td>
            <td><%= workouts[i].notes %></td>
            <td>
              <a href="/workouts/edit/<%= workouts[i]._id %>" class="btn btn-sm btn-secondary"><i class="fa-solid fa-pen"></i> Edit</a>
              <a href="/workouts/delete/<%= workouts[i]._id %>" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i> Delete</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
