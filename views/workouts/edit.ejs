<%- include('../partials/header') %>

<h1><i class="fa-solid fa-pen"></i> Edit Workout</h1>

<!-- same form as add.ejs, but filled in with the old values -->
<form action="/workouts/edit/<%= workout._id %>" method="POST" class="card p-4">
  <div class="mb-3">
    <label for="exercise" class="form-label">Exercise</label>
    <input type="text" id="exercise" name="exercise" class="form-control" value="<%= workout.exercise %>" required>
  </div>
  <div class="mb-3">
    <label for="category" class="form-label">Category</label>
    <select id="category" name="category" class="form-select" required>
      <option <% if (workout.category == 'Strength') { %>selected<% } %>>Strength</option>
      <option <% if (workout.category == 'Cardio') { %>selected<% } %>>Cardio</option>
      <option <% if (workout.category == 'Flexibility') { %>selected<% } %>>Flexibility</option>
      <option <% if (workout.category == 'Sports') { %>selected<% } %>>Sports</option>
    </select>
  </div>
  <div class="row">
    <div class="col-md-4 mb-3">
      <label for="sets" class="form-label">Sets</label>
      <input type="number" id="sets" name="sets" class="form-control" min="0" value="<%= workout.sets %>">
    </div>
    <div class="col-md-4 mb-3">
      <label for="reps" class="form-label">Reps</label>
      <input type="number" id="reps" name="reps" class="form-control" min="0" value="<%= workout.reps %>">
    </div>
    <div class="col-md-4 mb-3">
      <label for="duration" class="form-label">Minutes</label>
      <input type="number" id="duration" name="duration" class="form-control" min="0" value="<%= workout.duration %>">
    </div>
  </div>
  <div class="mb-3">
    <label for="date" class="form-label">Date</label>
    <input type="date" id="date" name="date" class="form-control" value="<%= workout.date.toISOString().substring(0, 10) %>" required>
  </div>
  <div class="mb-3">
    <label for="notes" class="form-label">Notes</label>
    <textarea id="notes" name="notes" class="form-control" rows="2"><%= workout.notes %></textarea>
  </div>
  <div>
    <button type="submit" class="btn btn-outline-navy"><i class="fa-solid fa-floppy-disk"></i> Update</button>
    <a href="/workouts" class="btn btn-secondary">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
